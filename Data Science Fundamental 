Appendix: Complete Analysis Code
Run with Python 3, NumPy, pandas and SciPy installed. The random seed makes the results reproducible.
import numpy as np
import pandas as pd
from scipy import stats
 
np.random.seed(42)
n = 200
df = pd.DataFrame({
    "student_id": range(1, n + 1),
    "study_hours": np.round(np.random.normal(6, 2, n).clip(0.5, 12), 1),
    "attendance_pct": np.round(np.random.normal(80, 10, n).clip(40, 100), 1),
    "group": np.random.choice(["A", "B"], n),
    "grade_level": np.random.choice(["Low", "Medium", "High"], n, p=[.2, .5, .3]),
})
df["score"] = np.round(35 + 4.5 * df["study_hours"] + 0.25 * df["attendance_pct"]
                       + np.random.normal(0, 6, n), 1).clip(0, 100)
# inject missing values and a duplicate
df.loc[np.random.choice(n, 10, replace=False), "attendance_pct"] = np.nan
df = pd.concat([df, df.iloc[[5]]], ignore_index=True)
 
print("SHAPE", df.shape)
print("DTYPES"); print(df.dtypes)
print("MISSING"); print(df.isna().sum())
print("DUPES", df.duplicated().sum())
 
df = df.drop_duplicates()
df["attendance_pct"] = df["attendance_pct"].fillna(df["attendance_pct"].median())
df["group"] = df["group"].astype("category")
df["grade_level"] = pd.Categorical(df["grade_level"], categories=["Low","Medium","High"], ordered=True)
 
print("DESCRIBE"); print(df[["study_hours","attendance_pct","score"]].describe().round(2))
print("MODE group", df["group"].mode()[0])
print("SKEW", df["score"].skew().round(3), "KURT", df["score"].kurt().round(3))
print("CORR"); print(df[["study_hours","attendance_pct","score"]].corr().round(3))
 
a = df[df.group=="A"]["score"]; b = df[df.group=="B"]["score"]
t, p = stats.ttest_ind(a, b, equal_var=False)
print("MEANS", a.mean().round(2), b.mean().round(2), "t", round(t,3), "p", round(p,4))
ci = stats.t.interval(0.95, len(df)-1, loc=df["score"].mean(), scale=stats.sem(df["score"]))
print("CI", np.round(ci,2))
r, pr = stats.pearsonr(df["study_hours"], df["score"])
print("PEARSON", round(r,3), pr)
slope, intercept, rv, pv, se = stats.linregress(df["study_hours"], df["score"])
print("LINREG", round(slope,3), round(intercept,3), round(rv**2,3))
print(df.groupby("grade_level", observed=True)["score"].agg(["count","mean"]).round(2))
